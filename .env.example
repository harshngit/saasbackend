# Copy to .env and adjust for your environment.

# Local dev uses SQLite. For production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/crm_saas
# PlanetScale (and some other managed-Postgres providers) hand out a URL ending
# ?sslmode=verify-full&sslrootcert=system — "system" tells libpq to trust the
# OS's own CA bundle, which isn't guaranteed to exist in every environment. The
# app rewrites that one value (only that value — sslmode stays verify-full, every
# other parameter is untouched) to the bundled `certifi` CA file automatically;
# nothing needs to be done here beyond using the URL PlanetScale gives you as-is.
DATABASE_URL=sqlite:///./crm_saas.db

# --- PostgreSQL connection pool (ignored for SQLite) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300

# CHANGE THIS in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-insecure-secret-change-me

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of allowed CORS origins (Flutter web dev server, etc.)
CORS_ORIGINS=*

# Swagger / ReDoc / OpenAPI documentation exposure (gates /docs, /redoc, and
# /openapi.json together — see app/main.py).
# Production MUST set this to false — leave it false here too, since this file
# is the template every environment (including production) copies from.
# For local development, set ENABLE_DOCS=true in your own .env (not here) if
# you want the interactive docs while working on the API.
ENABLE_DOCS=false

# --- Google Sign-In & OAuth 2.0 Redirect ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173

# --- Password reset ---
RESET_TOKEN_EXPIRE_MINUTES=30
# Front-end page that handles the ?token=... link from the reset email.
FRONTEND_RESET_URL=http://localhost:8080/reset-password
# DEV ONLY: return the raw reset token in the API response (no mailbox needed).
# MUST be false in production.
EXPOSE_RESET_TOKEN=false

# --- SMTP (leave SMTP_HOST empty to just log emails to the console in dev) ---
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true,
# SMTP_USER=you@gmail.com, SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CRM SaaS <no-reply@crm-saas.local>
SMTP_USE_TLS=true

# Super Admin (platform owner) seeded on startup via `python -m app.seed`
# CHANGE THIS in every real environment — do not leave it unset in production,
# and never reuse this file's old example value (Admin@123) anywhere real.
SUPER_ADMIN_EMAIL=superadmin@demo.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Ravi Malhotra

# --- File storage: one-off inline-upload conversion (see app/services/file_migration_service.py) ---
# Off by default. Run explicitly instead: python -m app.scripts.convert_inline_uploads
CONVERT_INLINE_UPLOADS_ON_STARTUP=false

# --- Cloudflare R2 (S3-compatible) file storage — optional, Phase 2 ---
# Leave all four empty to keep today's DB-backed file storage unchanged. R2 is only
# used once every one of these is set. Never commit real values here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Public base URL for API responses ---
# Database storage always stays host-independent (/files/<id>) — this setting
# never changes that. It only controls whether *_url fields in API responses
# (uploads, logos, profile photos, category images, documents, etc.) are
# returned relative (/files/<id>, today's default) or absolute
# ({PUBLIC_BASE_URL}/files/<id>). Leave blank to keep responses relative.
# Production should set this to the current public backend URL, e.g.:
# PUBLIC_BASE_URL=https://crm-saas-backend.bsmart.workers.dev
# Local developers may set it to their own local backend URL if their
# frontend needs absolute links (usually unnecessary — leave blank otherwise).
PUBLIC_BASE_URL=
